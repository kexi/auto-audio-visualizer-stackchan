{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // react / import はデフォルト off なので明示的に有効化する。
  // typescript / unicorn / oxc はデフォルト on だが、意図を明示するため列挙する。
  "plugins": ["react", "import", "typescript", "unicorn", "oxc"],
  // correctness のみを error として扱う。pedantic / style 系は
  // max-lines や no-negated-condition のようにこのコードベースでは
  // 有益でない指摘が大量に出るため有効にしない。
  "categories": {
    "correctness": "error"
  },
  "rules": {
    // tsconfig.app.json が "jsx": "react-jsx"（新しい JSX 変換）なので、
    // React を import する必要はない。有効だと全 JSX 行が誤検知になる。
    "react/react-in-jsx-scope": "off",
    // 以下は型情報を必要とするルール。`--type-aware` 付きでのみ評価される。
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error"
  },
  "ignorePatterns": ["dist", "node_modules"]
}
