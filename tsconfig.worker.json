{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "target": "ES2023",
    // Worker は DOM でも Node でもない。lib は素の ES だけにして、
    // ランタイムの型（Request / WebSocket / DurableObjectState など）は
    // すべて @cloudflare/workers-types から入れる。
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Runtime types。ここを絞ることで @types/node などがワーカー側に
       紛れ込まない（紛れると Node にしか無い API を書いても型が通ってしまう）。 */
    "types": ["@cloudflare/workers-types"],

    /* Strictness — tsconfig.app.json と揃える */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["worker"]
}
